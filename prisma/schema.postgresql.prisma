generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN, STAFF
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]

  @@index([email])
}

model Business {
  id              String   @id @default(uuid())
  nameEn          String   @default("Aroma Coffee")
  nameAr          String   @default("مقهى أروما")
  logoUrl         String?
  phone           String?
  addressEn       String?
  addressAr       String?
  currency        String   @default("SAR")
  timezone        String   @default("Asia/Riyadh")
  taxEnabled      Boolean  @default(false)
  taxRate         Float    @default(0.0)
  pricingMode     String   @default("INCLUSIVE") // INCLUSIVE, EXCLUSIVE
  invoicePrefix   String   @default("INV-")
  receiptFooterEn String?  @default("Thank you for visiting Aroma Coffee!")
  receiptFooterAr String?  @default("شكراً لزيارتكم مقهى أروما!")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id            String   @id @default(uuid())
  businessId    String
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         Item[]

  @@index([businessId])
  @@index([sortOrder])
}

model Item {
  id            String   @id @default(uuid())
  businessId    String
  categoryId    String
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  type          String   @default("PRODUCT") // PRODUCT, SERVICE
  basePrice     Float
  sku           String?
  barcode       String?
  stockEnabled  Boolean  @default(false)
  stockQuantity Int      @default(0)
  variationMode String   @default("NONE") // NONE, OPTION, VARIANT
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variationGroups VariationGroup[]
  variants        ProductVariant[]
  saleItems       SaleItem[]

  @@index([categoryId])
  @@index([sku])
  @@index([barcode])
  @@index([nameEn])
  @@index([nameAr])
}

model VariationGroup {
  id            String   @id @default(uuid())
  itemId        String
  nameEn        String
  nameAr        String
  required      Boolean  @default(false)
  selectionType String   @default("SINGLE") // SINGLE, MULTIPLE
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item                  Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options               VariationOption[]
  productVariantOptions ProductVariantOption[]

  @@index([itemId])
}

model VariationOption {
  id               String   @id @default(uuid())
  variationGroupId String
  nameEn           String
  nameAr           String
  priceAdjustment  Float    @default(0.0)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variationGroup        VariationGroup         @relation(fields: [variationGroupId], references: [id], onDelete: Cascade)
  productVariantOptions ProductVariantOption[]

  @@index([variationGroupId])
}

model ProductVariant {
  id            String   @id @default(uuid())
  itemId        String
  sku           String?
  barcode       String?
  price         Float
  stockQuantity Int      @default(0)
  imageUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item           Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variantOptions ProductVariantOption[]
  saleItems      SaleItem[]

  @@index([itemId])
  @@index([sku])
  @@index([barcode])
}

model ProductVariantOption {
  id                String @id @default(uuid())
  productVariantId  String
  variationGroupId  String
  variationOptionId String

  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  variationGroup  VariationGroup  @relation(fields: [variationGroupId], references: [id], onDelete: Cascade)
  variationOption VariationOption @relation(fields: [variationOptionId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, variationGroupId])
  @@index([productVariantId])
  @@index([variationOptionId])
}

model Sale {
  id             String   @id @default(uuid())
  businessId     String
  userId         String
  subtotal       Float
  discountType   String   @default("NONE") // NONE, PERCENTAGE, FIXED
  discountValue  Float    @default(0.0)
  discountAmount Float    @default(0.0)
  taxAmount      Float    @default(0.0)
  totalAmount    Float
  paymentMethod  String   @default("CASH") // CASH, CARD, OTHER
  orderType      String   @default("TAKEAWAY") // DINE_IN, TAKEAWAY
  status         String   @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  items     SaleItem[]
  invoice   Invoice?

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id                 String   @id @default(uuid())
  saleId             String
  itemId             String
  variantId          String?
  itemNameEnSnapshot String
  itemNameArSnapshot String
  quantity           Int
  baseUnitPrice      Float
  variationAmount    Float    @default(0.0)
  unitPrice          Float
  discountAmount     Float    @default(0.0)
  lineTotal          Float
  createdAt          DateTime @default(now())

  sale    Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item    Item              @relation(fields: [itemId], references: [id])
  variant ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  options SaleItemOption[]

  @@index([saleId])
  @@index([itemId])
  @@index([variantId])
}

model SaleItemOption {
  id                   String @id @default(uuid())
  saleItemId           String
  variationGroupNameEn String
  variationGroupNameAr String
  optionNameEn         String
  optionNameAr         String
  priceAdjustment      Float  @default(0.0)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  @@index([saleItemId])
}

model Invoice {
  id                String   @id @default(uuid())
  businessId        String
  saleId            String   @unique
  invoiceNumber     String   @unique
  issueDate         String
  issueTime         String
  businessNameEn    String
  businessNameAr    String
  businessAddressEn String?
  businessAddressAr String?
  subtotal          Float
  discount          Float
  tax               Float    @default(0.0)
  totalAmount       Float
  paymentMethod     String
  status            String   @default("ISSUED") // ISSUED, VOID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([createdAt])
}

model InvoiceSequence {
  id            Int      @id @default(autoincrement())
  prefix        String   @default("INV-")
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
}

